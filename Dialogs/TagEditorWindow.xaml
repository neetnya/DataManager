<Window x:Class="DataManager.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签"
        Width="520"
        Height="540"
        MinWidth="420"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 归属说明 -->
        <Border Grid.Row="0"
                Background="#F1F6FF"
                BorderBrush="{StaticResource TagBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,9"
                Margin="0,0,0,12">
            <TextBlock x:Name="TxtScope"
                       Text=""
                       Foreground="{StaticResource TextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <!-- 新增标签 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="TxtNewTag" Width="220" MinHeight="30" />
            <Button Content="添加"
                    IsDefault="True"
                    MinWidth="72"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnAdd" />
            <TextBlock Style="{StaticResource HintText}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="回车即可添加" />
        </StackPanel>

        <!-- 已有标签列表：每行可单独添加 / 移除 / 删除整标签 -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel x:Name="TagRows" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="TxtSummary"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center" />
            <Button Content="关闭"
                    HorizontalAlignment="Right"
                    MinWidth="82"
                    IsCancel="True"
                    Click="OnClose" />
        </Grid>
    </Grid>
</Window>
