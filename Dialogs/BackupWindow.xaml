<Window x:Class="DataManager.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份 / 恢复"
        Width="780"
        Height="600"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,11">
            <TextBlock Text="备份 / 恢复"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,0">
            <StackPanel>
                <!-- 本地备份 -->
                <GroupBox Header="本地备份">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="立即备份"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="OnLocalBackup" />
                            <Button Content="打开备份文件夹"
                                    Margin="8,0,0,0"
                                    Click="OnOpenBackupFolder" />
                            <Button Content="刷新列表"
                                    Margin="8,0,0,0"
                                    Click="OnRefreshBackups" />
                        </StackPanel>

                        <DataGrid x:Name="BackupGrid"
                                  Margin="0,12,0,0"
                                  Height="130"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeight="28"
                                  ColumnHeaderHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="备份文件"
                                                    Binding="{Binding FileName}"
                                                    Width="*"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="大小"
                                                    Binding="{Binding SizeText}"
                                                    Width="90"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="时间"
                                                    Binding="{Binding TimeText}"
                                                    Width="150"
                                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="恢复选中的本地备份"
                                    Style="{StaticResource DangerButton}"
                                    Click="OnRestoreLocal" />
                            <Button x:Name="BtnDeleteBackup"
                                    Content="删除选中备份"
                                    Margin="8,0,0,0"
                                    Click="OnDeleteBackup" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="本地备份保留份数（0 = 保留全部）"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox x:Name="TxtKeepCount"
                                     Width="70"
                                     Text="0" />
                            <Button Content="应用保留策略"
                                    Margin="8,0,0,0"
                                    Click="OnApplyRetention" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- WebDAV -->
                <GroupBox Header="WebDAV 备份与恢复">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="地址"
                                       Style="{StaticResource HintText}"
                                       Margin="0,0,10,8" />
                            <TextBox x:Name="TxtUrl"
                                     Grid.Row="0" Grid.Column="1"
                                     Margin="0,0,0,8"
                                     ToolTip="例如 https://dav.example.com/dav/" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="账号"
                                       Style="{StaticResource HintText}"
                                       Margin="0,0,10,8" />
                            <TextBox x:Name="TxtUser"
                                     Grid.Row="1" Grid.Column="1"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="密码"
                                       Style="{StaticResource HintText}"
                                       Margin="0,0,10,8" />
                            <PasswordBox x:Name="TxtPassword"
                                         Grid.Row="2" Grid.Column="1"
                                         Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="远端目录"
                                       Style="{StaticResource HintText}"
                                       Margin="0,0,10,8" />
                            <TextBox x:Name="TxtRemoteDir"
                                     Grid.Row="3" Grid.Column="1"
                                     Margin="0,0,0,8"
                                     ToolTip="留空 = 直接存在地址所在目录。填了但不存在时，上传会自动创建。" />

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="文件名前缀"
                                       Style="{StaticResource HintText}"
                                       Margin="0,0,10,0" />
                            <TextBox x:Name="TxtRemoteName"
                                     Grid.Row="4" Grid.Column="1"
                                     Text="DataManager"
                                     ToolTip="上传的文件名为「前缀_日期_时间.sqlite」，每次都是新文件，不会覆盖历史备份。" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存配置"
                                    Click="OnSaveDavConfig" />
                            <Button Content="测试连接"
                                    Margin="8,0,0,0"
                                    Click="OnTestConnection" />
                            <Button Content="上传到 WebDAV"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OnUpload" />
                            <Button x:Name="BtnListRemote"
                                    Content="刷新远端备份列表"
                                    Margin="8,0,0,0"
                                    Click="OnRefreshRemote" />
                        </StackPanel>

                        <DataGrid x:Name="RemoteGrid"
                                  Margin="0,12,0,0"
                                  Height="130"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeight="28"
                                  ColumnHeaderHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="远端备份文件"
                                                    Binding="{Binding FileName}"
                                                    Width="*"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="大小"
                                                    Binding="{Binding SizeText}"
                                                    Width="90"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="时间"
                                                    Binding="{Binding TimeText}"
                                                    Width="150"
                                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnRestoreRemote"
                                    Content="从选中的远端备份恢复"
                                    Style="{StaticResource DangerButton}"
                                    Click="OnDownloadAndRestore" />
                            <TextBlock x:Name="TxtRemoteStatus"
                                       Style="{StaticResource HintText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnCancelOp"
                                    Content="取消"
                                    IsEnabled="False"
                                    Click="OnCancelOperation" />
                            <TextBlock x:Name="TxtDavStatus"
                                       Style="{StaticResource HintText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="" />
                        </StackPanel>

                        <ProgressBar x:Name="OpProgress"
                                     Margin="0,10,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="TxtLocalStatus"
                           Style="{StaticResource HintText}"
                           Margin="0,0,0,10"
                           Text="" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,11">
            <Button Content="关闭"
                    HorizontalAlignment="Right"
                    MinWidth="88"
                    Click="OnClose" />
        </Border>
    </Grid>
</Window>
