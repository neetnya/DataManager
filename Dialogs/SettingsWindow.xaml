<Window x:Class="DataManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="设置"
        Width="1080"
        Height="680"
        MinWidth="880"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- 左：表列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="数据表"
                           Style="{StaticResource SectionTitle}" />

                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListBox x:Name="TableList"
                             Style="{StaticResource PlainListBox}"
                             SelectionChanged="OnTableSelected" />
                </Border>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="新建表"
                            HorizontalAlignment="Stretch"
                            Click="OnNewTable"
                            Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="重命名"
                                HorizontalAlignment="Stretch"
                                Click="OnRenameTable" />
                        <Button Grid.Column="2"
                                Content="删除表"
                                Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Stretch"
                                Click="OnDeleteTable" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 右：列配置 / 外观 -->
            <TabControl x:Name="Tabs"
                        Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0">
                <TabItem Header="列配置">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <DataGrid x:Name="ColumnGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="All"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      RowHeight="34"
                                      ColumnHeaderHeight="36"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="顺序"
                                                        Binding="{Binding DisplayOrdinal}"
                                                        Width="46"
                                                        IsReadOnly="True" />

                                    <DataGridTemplateColumn Header="快捷查询" Width="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsQuick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="被查询" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsQueried, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="唯一" Width="54">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsUnique, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="分组" Width="54">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="排序列" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="URL" Width="54">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="方向" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedIndex="{Binding SortDirectionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding IsSort}"
                                                          Margin="4,2"
                                                          MinHeight="26">
                                                    <sys:String>升序</sys:String>
                                                    <sys:String>降序</sys:String>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="排序优先级"
                                                        Binding="{Binding SortPriorityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                        Width="80" />

                                    <DataGridTemplateColumn Header="排序调整" Width="112">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Content="上移"
                                                            Padding="7,2"
                                                            MinHeight="24"
                                                            IsEnabled="{Binding IsSort}"
                                                            Click="OnSortUp" />
                                                    <Button Content="下移"
                                                            Padding="7,2"
                                                            MinHeight="24"
                                                            Margin="4,0,0,0"
                                                            IsEnabled="{Binding IsSort}"
                                                            Click="OnSortDown" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="操作" Width="96">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除列"
                                                        Padding="8,2"
                                                        MinHeight="24"
                                                        Margin="4,2"
                                                        Style="{StaticResource DangerButton}"
                                                        Click="OnDeleteColumn" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <Button Content="添加列"
                                    Click="OnAddColumn" />
                            <TextBlock x:Name="TxtColumnCount"
                                       Style="{StaticResource HintText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="数据">
                    <Grid Margin="0,10,0,0">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="CSV"
                                           Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导入 CSV"
                                            MinWidth="120"
                                            Click="OnImportCsv" />
                                    <Button Content="导出全部 CSV"
                                            MinWidth="120"
                                            Margin="8,0,0,0"
                                            Click="OnExportCsv" />
                                </StackPanel>

                                <TextBlock Text="备份 / 恢复"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0,20,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="本地备份与恢复"
                                            MinWidth="150"
                                            Click="OnOpenBackup" />
                                </StackPanel>

                                <TextBlock Text="分组"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0,20,0,8" />
                                <Grid Width="440" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="分隔符"
                                               Style="{StaticResource HintText}"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtGroupSeparator"
                                             Grid.Column="1"
                                             MinHeight="28"
                                             TextChanged="OnGroupSeparatorChanged"
                                             ToolTip="分组列一个单元格里含多个分组值时用此符号分隔；留空表示不拆分" />
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="分隔符前后会自动补一个空格；留空表示不拆分。" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="外观">
                    <Grid Margin="0,10,0,0">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="右侧表格的文本样式"
                                           Style="{StaticResource SectionTitle}" />

                                <Grid Width="440" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="字体"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,10,8" />
                                    <ComboBox x:Name="CmbFontFamily"
                                              Grid.Row="0" Grid.Column="1"
                                              Margin="0,0,0,8"
                                              SelectionChanged="OnAppearanceChanged" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="字号"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,10,8" />
                                    <ComboBox x:Name="CmbFontSize"
                                              Grid.Row="1" Grid.Column="1"
                                              Margin="0,0,0,8"
                                              SelectionChanged="OnAppearanceChanged" />

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="行高"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,10,8" />
                                    <ComboBox x:Name="CmbRowHeight"
                                              Grid.Row="2" Grid.Column="1"
                                              Margin="0,0,0,8"
                                              SelectionChanged="OnAppearanceChanged" />

                                    <StackPanel Grid.Row="3" Grid.Column="1"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <CheckBox x:Name="ChkBold"
                                                  Content="加粗"
                                                  Margin="0,0,18,0"
                                                  Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                                        <CheckBox x:Name="ChkItalic"
                                                  Content="倾斜"
                                                  Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                                    </StackPanel>

                                    <CheckBox x:Name="ChkShowLines"
                                              Grid.Row="4" Grid.Column="1"
                                              Content="显示网格线"
                                              Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                                </Grid>

                                <TextBlock Text="预览"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0,16,0,8" />

                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="0">
                                    <StackPanel x:Name="PreviewArea" />
                                </Border>

                                <Button Content="恢复默认外观"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0"
                                        Click="OnResetAppearance" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,11"
                Margin="0,14,0,0">
            <Grid>
                <TextBlock x:Name="TxtDirty"
                           Text="有未保存的改动"
                           Foreground="#C77700"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="取消"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Click="OnCancel" />
                    <Button Content="保存"
                            MinWidth="88"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
