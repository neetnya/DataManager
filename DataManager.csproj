<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DataManager</AssemblyName>
    <RootNamespace>DataManager</RootNamespace>
    <ApplicationIcon>DataManager.ico</ApplicationIcon>
    <AssemblyTitle>轻量数据管理工具</AssemblyTitle>
    <Product>轻量数据管理工具</Product>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>DataManager</Company>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <StartupObject>DataManager.App</StartupObject>
  </PropertyGroup>

  <!--
    本项目刻意不引用任何 NuGet 包：
      * SQLite 使用 Windows 10 自带的 winsqlite3.dll（SQLite 3.43.x），通过 P/Invoke 调用
      * WebDAV / HTTP 使用 BCL 的 System.Net.Http
      * CSV / JSON 自行实现
    因此 `dotnet build` 在完全离线的机器上也能成功。
  -->

</Project>
